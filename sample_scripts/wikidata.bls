.lang en

.name ~                en       "is a"
.name ~                wikidata P279
#.name ~                wikidata P31
.name ->               wikidata Q18616576
.name "is part of"     wikidata P361
.name "has part"       wikidata P527
.name "is opposite of" wikidata P461
